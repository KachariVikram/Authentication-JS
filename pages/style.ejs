<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alcheringa System</title>
    <style>
        /* ==========================================================================
           1. GLOBAL STYLES & RESET
           ========================================================================== */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            justify-content: center;
            align-items: center;
        }

        /* ==========================================================================
           2. CARD CONTAINERS
           ========================================================================== */
        .auth-container {
            background: #ffffff;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
            box-sizing: border-box;
        }

        h1 {
            color: #1e293b;
            text-align: center;
            margin-top: 0;
            margin-bottom: 2rem;
            font-size: 1.8rem;
            font-weight: 700;
        }

        /* ==========================================================================
           3. FORM LAYOUT GROUPS
           ========================================================================== */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 1.25rem;
        }

        .form-group label {
            color: #475569;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s, box-shadow 0.2s;
            background-color: #fff;
        }

        .search-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        /* ==========================================================================
           4. UNIFORM ACTION BUTTONS & NAVIGATION LINKS
           ========================================================================== */
        .search-btn {
            width: 100%;
            background-color: #0f172a;
            color: #ffffff;
            border: none;
            padding: 0.85rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 1rem;
            transition: background-color 0.2s, transform 0.1s;
            text-decoration: none;
            text-align: center;
            display: block;
            box-sizing: border-box;
            line-height: 1.2;
        }

        .search-btn:hover {
            background-color: #1e293b;
        }

        .search-btn:active {
            transform: scale(0.99);
        }

        .auth-switch-link {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            color: #0284c7;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .auth-switch-link:hover {
            text-decoration: underline;
        }

        /* ==========================================================================
           5. ALERTS & SYSTEM INFOS
           ========================================================================== */
        .error-box {
            margin-top: 1.25rem;
            padding: 0.75rem;
            border-radius: 6px;
            text-align: center;
        }
        .error-msg {
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* ==========================================================================
           6. PROFILE DASHBOARD CUSTOM EXTENSIONS
           ========================================================================== */
        .profile-data-block {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            margin-bottom: 1.25rem;
            background: #f8fafc;
            padding: 0.85rem 1rem;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
        }
        .profile-label {
            margin: 0;
            font-size: 0.75rem;
            color: #64748b;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .profile-value {
            margin: 0;
            font-size: 1.05rem;
            color: #0f172a;
            font-weight: 600;
            word-break: break-all;
        }
        .avatar-circle {
            background: #f1f5f9;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 1.5rem auto;
            border: 1px solid #e2e8f0;
        }
    </style>
</head>