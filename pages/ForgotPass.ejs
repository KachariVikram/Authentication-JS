<%- include('./style.ejs') %>
<body>

    <div class="auth-container">
        <h1>Forgot Password</h1>
        <p style="text-align: center; color: #64748b; font-size: 0.9rem; margin-top: -1rem; margin-bottom: 2rem;">
            Enter your registered email address to receive a secure password recovery passcode.
        </p>
        
        <form action="/forgot-password" method="POST">
            <!-- Email Input Field -->
            <div class="form-group">
                <label for="email">Registered Email</label>
                <input 
                    type="email" 
                    id="email"
                    name="email" 
                    class="search-input" 
                    placeholder="Enter email address..." 
                    required 
                    autocomplete="off"
                    value="<%= locals.email ? email : '' %>"
                >
            </div>

            <!-- BUTTON 1: Request Recovery OTP -->
            <button type="submit" name="action" value="request_recovery_otp" class="search-btn" style="background-color: #0284c7; margin-bottom: 1.5rem;">
                Send Recovery OTP
            </button>

            <!-- Hardcoded OTP Input Block -->
            <div class="form-group" style="background: #f8fafc; padding: 1rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                <label for="otp" style="color: #0f172a;">Enter Recovery OTP</label>
                <input 
                    type="text" 
                    id="otp"
                    name="otp" 
                    class="search-input" 
                    placeholder="******" 
                    maxlength="6"
                    autocomplete="off"
                    style="text-align: center; letter-spacing: 0.2em; font-weight: bold; font-size: 1.2rem;"
                >
                <small style="color: #64748b; font-size: 0.75rem; margin-top: 6px; display: block; text-align: center; line-height: 1.4;">
                    Click "Send Recovery OTP" above first, then verify the code here.
                </small>
            </div>
            
            <!-- BUTTON 2: Verify Recovery OTP Below Field -->
            <button type="submit" name="action" value="verify_recovery_otp" class="search-btn" style="background-color: #10b981;">
                Verify Code
            </button>
            
            <a href="/login" class="auth-switch-link">Return to Log In</a>
        </form>

        <!-- Dynamic Feedback Display Block -->
        <% if (locals.message) { %>
            <% if (locals.isSuccess) { %>
                <div class="error-box" style="background-color: #f0fdf4; border-color: #bbf7d0;">
                    <span class="error-msg" style="color: #16a34a;">✉️ <%= message %></span>
                </div>
            <% } else { %>
                <div class="error-box" style="background-color: #fef2f2; border-color: #fee2e2;">
                    <span class="error-msg" style="color: #ef4444;">⚠️ <%= message %></span>
                </div>
            <% } %>
        <% } %>
    </div>

</body>
